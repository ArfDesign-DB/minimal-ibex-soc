To run: hello world

1.in ibex-demo-system.core 

    targets:
  sim:
    default_tool: verilator
    filesets:
      - files_sim_verilator
    toplevel: top_verilator
    tools:
      verilator:
        mode: cc
        verilator_options:
          - '-Wno-UNOPTFLAT' # <------------ Add this line 
          - '--trace'
          - '--trace-fst' 
          - '--trace-structs'
          - '--trace-params'

2. create a virtual environment (from /minimal-ibex)

   #create command
 
   python3 -m venv myenv

   #start command
 
   source myenv/bin/activate

   # run all the below command inside virtual environment

3. install all python prequist

   pip3 install --user -r python-requirements.txt   ## if it doesn't work rerun with '--user' removed

4. check the riscv32_toolchain version and verilator version:-  

   riscv32-unknown-elf-gcc --version 

   #it should be 10.2.0, this is the most suitable one.
   #to inatall this virsion run below commands 
   
   wget https://github.com/lowRISC/lowrisc-toolchains/releases/download/20220524-1/lowrisc-toolchain-rv32imcb-20220524-1.tar.xz
   mkdir -p ./lowrisc-toolchain
   tar -xvf ~/lowrisc-toolchain-rv32imcb-20220524-1.tar.xz -C ./lowrisc-toolchain --strip-components=1
   export PATH=$(pwd)/lowrisc-toolchain/bin:$PATH

  verilator --version

  #it should be 4.210 best suitable for this build
  #install the required versions with below command

cd /tmp && curl -sSfL -o verilator-4.210.tar.gz "https://storage.googleapis.com/verilator-builds/verilator-v4.210.tar.gz" && sudo mkdir -p /tools/verilator && sudo tar -C /tools/verilator -xzf verilator-4.210.tar.gz && echo "extracted:" && ls /tools/verilator && echo "---try run---" && /tools/verilator/v4.210/bin/verilator --version 2>&1 | head -5


5. run below fussoc command from project root(from /minimal-ibex-soc/)

    fusesoc --cores-root=. run --target=sim --tool=verilator --setup --build lowrisc:ibex:demo_system

